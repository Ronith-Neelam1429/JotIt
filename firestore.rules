rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(data) { return signedIn() && request.auth.uid in data.memberIds; }
    function parent(jotId) { return get(/databases/$(database)/documents/jots/$(jotId)).data; }
    function encrypted(data) {
      return data.createdAt is int && data.updatedAt is int
        && data.encryptedPayload is string && data.encryptedPayload.size() < 950000
        && data.memberIds is list && data.ownerId is string
        && ((!('trashedAt' in data) && !('expiresAt' in data))
          || (data.trashedAt == null && data.expiresAt == null)
          || (data.trashedAt is timestamp && data.expiresAt is timestamp && data.expiresAt > data.trashedAt));
    }
    function privateJot(data) {
      return encrypted(data) && data.encryptionVersion == 1
        && data.keys().hasOnly(['createdAt', 'updatedAt', 'encryptedPayload', 'encryptionVersion', 'memberIds', 'ownerId', 'trashedAt', 'expiresAt']);
    }
    match /jots/{jotId} {
      allow create: if signedIn() && privateJot(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if member(resource.data);
      allow update: if member(resource.data) && (
        (!('collaboration' in resource.data) && resource.data.ownerId == request.auth.uid
          && privateJot(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds)
        || ('collaboration' in resource.data
          && resource.data.collaboration.members[request.auth.uid].role in ['owner', 'editor']
          && encrypted(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encryptedPayload', 'updatedAt', 'trashedAt', 'expiresAt', 'collaboration'])
          && request.resource.data.collaboration.diff(resource.data.collaboration).affectedKeys().hasOnly(['revision', 'lastEditedBy', 'lastEditedAt'])
          && request.resource.data.collaboration.revision == resource.data.collaboration.revision + 1
          && request.resource.data.collaboration.lastEditedBy == request.auth.uid
          && request.resource.data.collaboration.lastEditedAt is int
          && (request.resource.data.trashedAt == resource.data.trashedAt || resource.data.ownerId == request.auth.uid))
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      match /keys/{userId} {
        allow read: if signedIn() && request.auth.uid == userId && member(parent(jotId));
      }
      match /invitations/{inviteId} {
        allow read: if signedIn() && parent(jotId).ownerId == request.auth.uid;
      }
      match /events/{eventId} {
        allow read: if member(parent(jotId));
      }
      match /presence/{userId} {
        allow read: if member(parent(jotId));
        allow create, update: if signedIn() && request.auth.uid == userId && member(parent(jotId))
          && request.resource.data.keys().hasOnly(['seenAt', 'active'])
          && request.resource.data.seenAt == request.time && request.resource.data.active is bool;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /users/{userId}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
    }
  }
}
