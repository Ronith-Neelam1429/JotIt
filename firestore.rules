rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isEncryptedJot() {
      return request.resource.data.keys().hasAll([
          'createdAt',
          'encryptedPayload',
          'encryptionVersion',
          'memberIds',
          'ownerId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'encryptedPayload',
          'encryptionVersion',
          'expiresAt',
          'memberIds',
          'ownerId',
          'trashedAt',
          'updatedAt'
        ])
        && request.resource.data.createdAt is int
        && request.resource.data.encryptedPayload is string
        && request.resource.data.encryptionVersion == 1
        && request.resource.data.memberIds is list
        && request.resource.data.ownerId is string
        && request.resource.data.updatedAt is int
        && (
          !request.resource.data.keys().hasAny(['expiresAt', 'trashedAt'])
          || (
            request.resource.data.keys().hasAll(['expiresAt', 'trashedAt'])
            && (
              (request.resource.data.expiresAt == null
                && request.resource.data.trashedAt == null)
              || (request.resource.data.expiresAt is timestamp
                && request.resource.data.trashedAt is timestamp
                && request.resource.data.expiresAt > request.resource.data.trashedAt)
            )
          )
        );
    }

    match /jots/{jotId} {
      allow create: if signedIn()
        && isEncryptedJot()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isMember();

      allow update: if isMember()
        && isEncryptedJot()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
